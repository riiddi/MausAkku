<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MausAkku</AssemblyName>
    <RootNamespace>MausAkku</RootNamespace>
    <ApplicationIcon>Icons\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.2.0</Version>
    <Product>MausAkku – Akkuanzeige für Glorious Model D 2 Wireless</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.1.0" />
    <EmbeddedResource Include="Icons\*.ico" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
